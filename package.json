{
  "name": "nnit-vpn-enterprise",
  "version": "2.5.0",
  "description": "Enterprise-Grade VPN Solution for Modern Businesses",
  "private": true,
  "workspaces": [
    "backend/*",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:api": "npm run dev --workspace=backend/api",
    "dev:auth": "npm run dev --workspace=backend/auth",
    "dev:admin": "npm run dev --workspace=backend/admin",
    "dev:billing": "npm run dev --workspace=backend/billing",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "clean": "npm run clean --workspaces --if-present",
    "deploy": "echo 'Deploy to production' && npm run build && npm run deploy:docker",
    "deploy:docker": "docker-compose -f infrastructure/docker/docker-compose.prod.yml up -d",
    "docker:dev": "docker-compose -f infrastructure/docker/docker-compose.yml up",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down",
    "db:migrate": "npm run migrate --workspace=backend/api",
    "db:seed": "npm run seed --workspace=backend/api"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/networkniceit/nnit-vpn-enterprise.git"
  },
  "keywords": [
    "vpn",
    "enterprise",
    "wireguard",
    "openvpn",
    "security",
    "networking"
  ],
  "author": "NetworkNiceIT",
  "license": "Enterprise"
}
